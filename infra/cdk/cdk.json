{
  "app": "npx ts-node --prefer-ts-exts bin/brainwave.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*",
      "node_modules",
      "test"
    ]
  },
  "context": {
    "@aws-cdk/aws-rds:databaseProxyUniqueResourceName": true,
    "stage": "dev"
  }
}
