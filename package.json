{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:onboarding": "playwright test --config e2e/playwright.config.ts e2e/onboarding",
    "sst:dev": "AWS_PROFILE=estrelar sst dev",
    "sst:deploy:dev": "AWS_PROFILE=estrelar SST_STAGE=dev sst deploy --stage dev",
    "sst:deploy:prod": "AWS_PROFILE=estrelar SST_STAGE=prod sst deploy --stage production",
    "sst:remove:dev": "AWS_PROFILE=estrelar sst remove --stage dev",
    "sst:remove:prod": "AWS_PROFILE=estrelar SST_STAGE=prod sst remove --stage production",
    "cdk:destroy:dev": "AWS_PROFILE=estrelar npm --prefix infra/cdk run destroy:dev",
    "cdk:destroy:prod": "AWS_PROFILE=estrelar npm --prefix infra/cdk run destroy:prod",
    "api:dev": "npm --prefix api run start:dev",
    "api:build": "npm --prefix api run build",
    "api:generate": "npm --prefix api run prisma:generate",
    "api:migrate:create": "npm --prefix api run prisma:migrate:create",
    "api:migrate:deploy": "npm --prefix api run prisma:migrate:deploy",
    "api:seed": "npm --prefix api run db:seed",
    "api:seed:test-user": "AWS_PROFILE=estrelar npm --prefix api run db:seed:test-user",
    "api:seed:test-user:upsells": "AWS_PROFILE=estrelar SEED_TEST_USER_INCLUDE_UPSELLS=1 npm --prefix api run db:seed:test-user",
    "api:seed:guest-account": "AWS_PROFILE=estrelar SEED_TEST_USER_EMAIL=underwriting@life-scale.com SEED_TEST_USER_PASSWORD='Underwriting123!!!' SEED_TEST_USER_NAME=Underwriting SEED_TEST_USER_INCLUDE_UPSELLS=1 SEED_TEST_USER_INCLUDE_ADDONS=1 npm --prefix api run db:seed:test-user",

    "cdk:synth": "npm --prefix api run package:lambda && AWS_PROFILE=estrelar npm --prefix infra/cdk run synth",
    "cdk:diff": "npm --prefix api run package:lambda && AWS_PROFILE=estrelar npm --prefix infra/cdk run diff",
    "cdk:deploy:dev": "npm --prefix api run package:lambda && AWS_PROFILE=estrelar npm --prefix infra/cdk run deploy:dev",
    "cdk:deploy:prod": "npm --prefix api run package:lambda && AWS_PROFILE=estrelar npm --prefix infra/cdk run deploy:prod",
    "deploy:dev": "npm run cdk:deploy:dev && npm run sst:deploy:dev",
    "deploy:prod": "npm run cdk:deploy:prod && npm run sst:deploy:prod",
    "deploy:api:dev": "npm run cdk:deploy:dev",
    "deploy:api:prod": "npm run cdk:deploy:prod",
    "api:package:lambda": "npm --prefix api run package:lambda",
    "deploy:web:dev": "npm run sst:deploy:dev",
    "deploy:web:prod": "npm run sst:deploy:prod",
    "export:questions": "npx tsx ./scripts/export-questions.ts",
    "create:funnel": "npx tsx ./scripts/create-funnel-from-questions.ts",
    "sendgrid:test": "npx tsx ./scripts/sendgrid-test-email.ts"
  },
