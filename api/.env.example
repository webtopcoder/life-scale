PORT=3001
# Dedicated DB on shared estrelar-infra RDS: iq_scale_dev | iq_scale
DB_NAME=iq_scale_dev
# postgresql://USER:PASSWORD@HOST:5432/iq_scale_dev?sslmode=require
DATABASE_URL=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
# Life-Scale payment provider
# Development and production: https://sirius.bigdog.app
# Production: https://sirius.bigdog.app
LIFESCALE_API_BASE_URL=https://sirius.bigdog.app
LIFESCALE_WEBHOOK_SECRET=
# X-API-Key for cancel / access / S2S upsell (no default — required for real partner calls)
LIFESCALE_API_KEY=
# Server-only signing key for 15-minute post-checkout report grants (32+ random bytes)
REPORT_GRANT_SECRET=
# Deprecated Breeze Cash (retired — keep empty)
BREEZE_API_KEY=
BREEZE_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
KLAVIYO_API_KEY=
PARTNER_API_KEY=
# Must be a strong shared secret. The API rejects missing keys and the
# placeholder value REPLACE_ME. Required for /api/partner/* chatbot MFA + refund.
